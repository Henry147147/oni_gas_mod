# Explicit developer observer. Never changes the default game/probe package.
if(NOT CMAKE_SYSTEM_NAME MATCHES "^(Windows|Linux)$" OR NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)$")
    message(FATAL_ERROR "The ONI observer requires native Windows/Linux x64")
endif()
enable_language(C)
include(FetchContent)
if(POLICY CMP0135)
    cmake_policy(SET CMP0135 NEW)
endif()
find_package(Python3 REQUIRED COMPONENTS Interpreter)
FetchContent_Declare(ma_funchook
    URL https://codeload.github.com/kubo/funchook/tar.gz/refs/tags/v1.1.3
    URL_HASH SHA256=4b0195e70524237e222dc34c53ac25e12677bb936e64eefe33189931688444c4
    SOURCE_SUBDIR observer-populate-only)
FetchContent_Declare(ma_distorm
    URL https://codeload.github.com/gdabah/distorm/tar.gz/ab59d6e193948cfa5d1482fb6c7e64870e9e93b9
    URL_HASH SHA256=3554976d3d03f9b72b8cca621ef6b54008dd9c3673eec0f2e05a6473cbc3faa5
    SOURCE_SUBDIR observer-populate-only)
# Populate pinned sources without running upstream's nested dependency downloads.
FetchContent_MakeAvailable(ma_funchook ma_distorm)
set(oni_generated "${CMAKE_CURRENT_BINARY_DIR}/oni-generated")
file(MAKE_DIRECTORY "${oni_generated}")
file(COPY "${ma_funchook_SOURCE_DIR}/LICENSE" DESTINATION "${oni_generated}/licenses/funchook")
file(COPY "${ma_distorm_SOURCE_DIR}/COPYING" DESTINATION "${oni_generated}/licenses/distorm")
file(WRITE "${oni_generated}/third-party-sources.txt"
    "Funchook 1.1.3: https://github.com/kubo/funchook/tree/88388db3c69e16c1560fee65c6857d75f5ce6fd5\n"
    "diStorm: https://github.com/gdabah/distorm/tree/ab59d6e193948cfa5d1482fb6c7e64870e9e93b9\n"
    "Pinned source archives and SHA256 values are in cmake/OniNativeBackend.cmake.\n")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/patch_distorm.py"
    "${ma_distorm_SOURCE_DIR}" COMMAND_ERROR_IS_FATAL ANY)
file(APPEND "${oni_generated}/third-party-sources.txt"
    "Local changes: patch_funchook.py (branch relocation and unaligned code operands), patch_funchook_unix.py (non-replacing Linux near allocation and bounded borrowed trampoline storage), and patch_distorm.py (unsigned flag and unaligned opcode access).\n")
# The release tarball omits its distorm git submodule. Copy only inside fetched
# build artifacts, preserving upstream sources and avoiding a floating git ref.
file(COPY "${ma_distorm_SOURCE_DIR}/" DESTINATION "${ma_funchook_SOURCE_DIR}/distorm")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/patch_funchook.py"
    "${ma_funchook_SOURCE_DIR}/src/funchook_x86.c" COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/patch_funchook_unix.py"
    "${ma_funchook_SOURCE_DIR}/src/funchook_unix.c"
    "${ma_funchook_SOURCE_DIR}/src/funchook.c" COMMAND_ERROR_IS_FATAL ANY)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/tools/patch_funchook_unix.py")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/tools/patch_funchook.py")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/tools/patch_distorm.py")
set(FUNCHOOK_BUILD_SHARED OFF CACHE BOOL "" FORCE)
set(FUNCHOOK_BUILD_STATIC ON CACHE BOOL "" FORCE)
set(FUNCHOOK_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(FUNCHOOK_INSTALL OFF CACHE BOOL "" FORCE)
set(FUNCHOOK_DISASM distorm CACHE STRING "" FORCE)
# Upstream's old policy scope predates CMake's IPO support. Keep its pinned C
# dependency build independent of our checked C++ IPO setting.
set(oni_ipo_release "${CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE}")
set(oni_ipo_relwithdebinfo "${CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELWITHDEBINFO}")
set(CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE FALSE)
set(CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELWITHDEBINFO FALSE)
add_subdirectory("${ma_funchook_SOURCE_DIR}" "${ma_funchook_BINARY_DIR}" EXCLUDE_FROM_ALL)
set(CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE "${oni_ipo_release}")
set(CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELWITHDEBINFO "${oni_ipo_relwithdebinfo}")
set_target_properties(funchook-static PROPERTIES POSITION_INDEPENDENT_CODE ON)

set(oni_profile_header "${oni_generated}/oni_profiles.hpp")
add_custom_command(OUTPUT "${oni_profile_header}"
    COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/oni_hook_profiles.py"
        header --output "${oni_profile_header}"
    DEPENDS "${PROJECT_SOURCE_DIR}/tools/oni_hook_profiles.py"
        "${PROJECT_SOURCE_DIR}/docs/native-hook-profiles.json"
    VERBATIM)
add_library(mixed_atmospheres_oni SHARED native/src/oni_backend.cpp native/src/oni_domain.cpp "${oni_profile_header}")
target_include_directories(mixed_atmospheres_oni PUBLIC native/include PRIVATE "${oni_generated}")
target_compile_definitions(mixed_atmospheres_oni PRIVATE MA_ONI_EXPORTS)
target_link_libraries(mixed_atmospheres_oni PRIVATE funchook-static ma_mac_closed_world ${CMAKE_DL_LIBS})
foreach(target ma_mac_closed_world ma_mac_reconstruction ma_mac_transport ma_mac_energy ma_mac_compression ma_mac_momentum_limiter ma_mac_shock_heat)
    set_target_properties(${target} PROPERTIES POSITION_INDEPENDENT_CODE ON)
endforeach()
set_target_properties(mixed_atmospheres_oni PROPERTIES CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN YES)
if(WIN32)
    set_target_properties(mixed_atmospheres_oni PROPERTIES PREFIX "")
endif()
if(MSVC)
    target_compile_options(mixed_atmospheres_oni PRIVATE /W4 /WX /permissive- /fp:precise)
else()
    target_compile_options(mixed_atmospheres_oni PRIVATE -Wall -Wextra -Wpedantic -Wconversion -Wshadow -Werror)
    target_link_options(mixed_atmospheres_oni PRIVATE "LINKER:--exclude-libs,ALL")
    if(MINGW AND NOT MA_SANITIZERS)
        target_link_options(mixed_atmospheres_oni PRIVATE -static)
    elseif(NOT MA_SANITIZERS)
        target_link_options(mixed_atmospheres_oni PRIVATE -static-libstdc++ -static-libgcc)
    endif()
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        set(oni_map "${oni_generated}/oni_exports.map")
        file(WRITE "${oni_map}" "{ global: ma_oni_*; local: *; };\n")
        target_link_options(mixed_atmospheres_oni PRIVATE "LINKER:--version-script=${oni_map}")
        set_property(TARGET mixed_atmospheres_oni APPEND PROPERTY LINK_DEPENDS "${oni_map}")
    endif()
endif()
if(MA_BUILD_TESTS)
    add_executable(ma_oni_backend_tests native/tests/oni_backend_tests.cpp)
    target_link_libraries(ma_oni_backend_tests PRIVATE mixed_atmospheres_oni)
    add_test(NAME native_oni_observer_abi COMMAND ma_oni_backend_tests)
    add_executable(ma_oni_detour_tests native/tests/oni_detour_tests.cpp)
    target_link_libraries(ma_oni_detour_tests PRIVATE funchook-static)
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        target_link_options(ma_oni_detour_tests PRIVATE "-Wl,--wrap=mmap" "-Wl,--wrap=mprotect" "-Wl,--wrap=munmap")
    endif()
    add_test(NAME native_oni_detour_relocation COMMAND ma_oni_detour_tests)
    add_executable(ma_oni_domain_tests native/tests/oni_domain_tests.cpp native/src/oni_domain.cpp)
    target_link_libraries(ma_oni_domain_tests PRIVATE ma_mac_closed_world)
    add_test(NAME native_oni_sealed_domain COMMAND ma_oni_domain_tests)
    add_executable(ma_oni_arithmetic_precision_tests native/tests/oni_arithmetic_precision_tests.cpp native/src/oni_domain.cpp)
    target_link_libraries(ma_oni_arithmetic_precision_tests PRIVATE ma_mac_closed_world)
    if(MSVC)
        target_compile_options(ma_oni_arithmetic_precision_tests PRIVATE /W4 /WX /permissive- /fp:strict)
    else()
        target_compile_options(ma_oni_arithmetic_precision_tests PRIVATE -Wall -Wextra -Wpedantic -Wconversion -Wshadow -Werror -ffp-contract=off -fno-fast-math)
    endif()
    add_test(NAME native_oni_arithmetic_environment COMMAND ma_oni_arithmetic_precision_tests)
    add_executable(ma_oni_mixed_domain_tests native/tests/oni_mixed_domain_tests.cpp native/src/oni_domain.cpp)
    target_link_libraries(ma_oni_mixed_domain_tests PRIVATE ma_mac_closed_world)
    if(MSVC)
        target_compile_options(ma_oni_mixed_domain_tests PRIVATE /W4 /WX /permissive- /fp:strict)
    else()
        target_compile_options(ma_oni_mixed_domain_tests PRIVATE -Wall -Wextra -Wpedantic -Wconversion -Wshadow -Werror -ffp-contract=off -fno-fast-math)
    endif()
    add_test(NAME native_oni_mixed_domain COMMAND ma_oni_mixed_domain_tests)
    add_executable(ma_oni_radial_consumption_tests native/tests/oni_radial_consumption_tests.cpp native/src/oni_domain.cpp)
    target_link_libraries(ma_oni_radial_consumption_tests PRIVATE ma_mac_closed_world)
    if(MSVC)
        target_compile_options(ma_oni_radial_consumption_tests PRIVATE /W4 /WX /permissive- /fp:strict)
    else()
        target_compile_options(ma_oni_radial_consumption_tests PRIVATE -Wall -Wextra -Wpedantic -Wconversion -Wshadow -Werror -ffp-contract=off -fno-fast-math)
    endif()
    add_test(NAME native_oni_radial_consumption COMMAND ma_oni_radial_consumption_tests)
    add_executable(ma_oni_frame_inputs_tests native/tests/oni_frame_inputs_tests.cpp native/src/oni_domain.cpp)
    target_link_libraries(ma_oni_frame_inputs_tests PRIVATE ma_mac_closed_world mixed_atmospheres_oni)
    if(MSVC)
        target_compile_options(ma_oni_frame_inputs_tests PRIVATE /W4 /WX /permissive- /fp:strict)
    else()
        target_compile_options(ma_oni_frame_inputs_tests PRIVATE -Wall -Wextra -Wpedantic -Wconversion -Wshadow -Werror -ffp-contract=off -fno-fast-math)
    endif()
    add_test(NAME native_oni_frame_inputs COMMAND ma_oni_frame_inputs_tests)
    add_executable(ma_oni_configured_domain_tests native/tests/oni_configured_domain_tests.cpp native/src/oni_domain.cpp)
    target_link_libraries(ma_oni_configured_domain_tests PRIVATE ma_mac_closed_world mixed_atmospheres_oni)
    if(MSVC)
        target_compile_options(ma_oni_configured_domain_tests PRIVATE /W4 /WX /permissive- /fp:strict)
    else()
        target_compile_options(ma_oni_configured_domain_tests PRIVATE -Wall -Wextra -Wpedantic -Wconversion -Wshadow -Werror -ffp-contract=off -fno-fast-math)
    endif()
    add_test(NAME native_oni_configured_domain COMMAND ma_oni_configured_domain_tests)
    add_executable(ma_mac_boundary_transfer_tests native/tests/mac_boundary_transfer_tests.cpp)
    target_link_libraries(ma_mac_boundary_transfer_tests PRIVATE ma_mac_closed_world)
    add_test(NAME mac_gas_boundary_transfers COMMAND ma_mac_boundary_transfer_tests)
    add_executable(ma_mac_thermal_tests native/tests/mac_thermal_tests.cpp)
    target_link_libraries(ma_mac_thermal_tests PRIVATE ma_mac_closed_world)
    add_test(NAME mac_occupied_conduction COMMAND ma_mac_thermal_tests)
    set_target_properties(ma_mac_mixture_thermal_tests PROPERTIES EXCLUDE_FROM_ALL FALSE)
    add_test(NAME mac_mixture_conduction COMMAND ma_mac_mixture_thermal_tests)
