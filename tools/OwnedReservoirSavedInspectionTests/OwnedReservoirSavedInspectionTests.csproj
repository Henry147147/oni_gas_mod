<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(InspectionTargetFramework)' == ''">net10.0</TargetFramework>
    <TargetFramework Condition="'$(InspectionTargetFramework)' != ''">$(InspectionTargetFramework)</TargetFramework>
    <OutputType Condition="'$(TargetFramework)' != 'netstandard2.1'">Exe</OutputType>
    <OutputType Condition="'$(TargetFramework)' == 'netstandard2.1'">Library</OutputType>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../managed/MixedAtmospheres.Oni/OwnedReservoirSavedTemplates.cs" Link="OwnedReservoirSavedTemplates.cs" />
    <Compile Include="../../managed/MixedAtmospheres.Oni/OwnedReservoirKsavInspection.cs" Link="OwnedReservoirKsavInspection.cs" />
    <Compile Remove="Program.cs" Condition="'$(TargetFramework)' == 'netstandard2.1'" />
  </ItemGroup>
</Project>
