<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(ReceiptPumpMono)' != 'true'">net10.0</TargetFramework>
    <TargetFramework Condition="'$(ReceiptPumpMono)' == 'true'">netstandard2.1</TargetFramework>
    <DefineConstants Condition="'$(ReceiptPumpMono)' == 'true'">$(DefineConstants);GAME_MONO</DefineConstants>
    <LangVersion>latest</LangVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ReceiptPumpPython Condition="'$(ReceiptPumpPython)' == ''">python3</ReceiptPumpPython>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../managed/MixedAtmospheres.Oni/ColonyReceiptPumpState.cs" Link="ColonyReceiptPumpState.cs"/>
    <Compile Include="../../managed/MixedAtmospheres.Oni/ColonySaveBarrier.cs" Link="ColonySaveBarrier.cs"/>
  </ItemGroup>
  <Target Name="GenerateActualReceiptBodies" BeforeTargets="CoreCompile">
    <Exec Command="&quot;$(ReceiptPumpPython)&quot; &quot;$(MSBuildThisFileDirectory)extract.py&quot; --root &quot;$(MSBuildThisFileDirectory)../..&quot; --out &quot;$(IntermediateOutputPath)receipt-pump&quot;"/>
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)receipt-pump/OwnerDelivery.cs"/>
      <Compile Include="$(IntermediateOutputPath)receipt-pump/PumpRuntime.cs"/>
    </ItemGroup>
  </Target>
</Project>
