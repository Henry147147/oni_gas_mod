<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OniGameDir Condition="'$(OniGameDir)' == ''">$(ONI_GAME_DIR)</OniGameDir>
    <OniManagedDir>$(OniGameDir)/OxygenNotIncluded_Data/Managed</OniManagedDir>
    <LoadSourcesDir Condition="'$(LoadSourcesDir)' == ''">../../managed/MixedAtmospheres.Oni</LoadSourcesDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(LoadContractOnly)' == 'true'">
    <TargetFramework>netstandard2.1</TargetFramework><OutputType>Library</OutputType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(LoadSourcesDir)/OwnedReservoirLoadHeaderV1.cs" Link="OwnedReservoirLoadHeaderV1.cs" />
    <Compile Include="$(LoadSourcesDir)/OwnedReservoirLoadAttempt.cs" Link="OwnedReservoirLoadAttempt.cs" />
    <Compile Include="$(LoadSourcesDir)/OwnedReservoirLoadBoundary.cs" Link="OwnedReservoirLoadBoundary.cs" />
    <Reference Include="Assembly-CSharp"><HintPath>$(OniManagedDir)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(OniManagedDir)/Assembly-CSharp-firstpass.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(OniManagedDir)/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(OniManagedDir)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="RequireGameAssemblies" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(OniManagedDir)/Assembly-CSharp.dll')" Text="Pass OniGameDir for the licensed inspected installation." />
  </Target>
</Project>
