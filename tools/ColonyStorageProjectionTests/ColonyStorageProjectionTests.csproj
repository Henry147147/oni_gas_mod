<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ProjectionPython Condition="'$(ProjectionPython)' == ''">python3</ProjectionPython>
  </PropertyGroup>
  <Target Name="ExtractProductionProjectionMethods" BeforeTargets="CoreCompile">
    <Exec Command="&quot;$(ProjectionPython)&quot; &quot;$(MSBuildThisFileDirectory)extract.py&quot; --root &quot;$(MSBuildThisFileDirectory)../..&quot; --out &quot;$(IntermediateOutputPath)projection&quot;"/>
    <ItemGroup><Compile Include="$(IntermediateOutputPath)projection/Production.cs"/><Compile Include="$(IntermediateOutputPath)projection/HeatClock.cs"/></ItemGroup>
  </Target>
</Project>
