<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <InflationTargetFramework Condition="'$(InflationTargetFramework)' == ''">net10.0</InflationTargetFramework>
    <TargetFramework>$(InflationTargetFramework)</TargetFramework>
    <OutputType Condition="'$(TargetFramework)' != 'netstandard2.1'">Exe</OutputType>
    <OutputType Condition="'$(TargetFramework)' == 'netstandard2.1'">Library</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings Condition="'$(TargetFramework)' != 'netstandard2.1'">enable</ImplicitUsings>
    <UseAppHost>false</UseAppHost>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../managed/MixedAtmospheres.Oni/OwnedReservoirSavedTemplates.cs" Link="OwnedReservoirSavedTemplates.cs" />
    <Compile Include="../../managed/MixedAtmospheres.Oni/OwnedReservoirSavedInflation.cs" Link="OwnedReservoirSavedInflation.cs" />
    <Compile Include="../../managed/MixedAtmospheres.Oni/OwnedReservoirSavedDeflateStructure.cs" Link="OwnedReservoirSavedDeflateStructure.cs" />
    <Compile Remove="Program.cs" Condition="'$(TargetFramework)' == 'netstandard2.1'" />
    <Content Include="Fixtures/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
