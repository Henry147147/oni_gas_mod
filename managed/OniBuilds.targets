<Project>
  <!-- Reference fingerprints of the inspected installations. Features select only incompatible APIs. -->
  <ItemGroup>
    <OniRelease Include="744825"
                WindowsManaged="a58e04d0ffdf89b86fb28b71ad900625b3b539db30d67f8c6269f73a9f5ae599"
                LinuxManaged="6db652990ad1038e86b3493ed43004e12bfd61e62a4be60c787a9a9b9ac52ee1"
                WindowsNative="031960f120ac1d59fd8e43f6e1a7369111c629b90c24d52186b691dfe2d8a727" Features="ONI_DIRECT_ROCKET_DELETE" />
    <OniRelease Include="763796"
                WindowsManaged="4dd6a2c87bb6fa4f211a9bbfc4bc033cc734ff09e62e917f39517ae8a066b370"
                LinuxManaged="801207a0e194ad11892c86af754ad4d3218d89de3a079c2179e24723947135d4"
                WindowsNative="1216e026693230dfc567fbbed7da8a3ae019641a2c5f6e332c297ecf610f4971" />
    <OniRelease Include="764025"
                WindowsManaged="96b192e45e044aa591e7143bbe1126d685dd1a195db7ba1632fdf4abd8fe3036"
                LinuxManaged="39dc204f0ec52e9e6af2f2c65fec27b6b928fa6d362e041c6592501f4925ae07"
                WindowsNative="02c18a626fd10b7253792a3f0e6e361d8ff54ba1db020b2c6af96b83c86f8bfd" />
  </ItemGroup>
  <Target Name="SelectOniApi" BeforeTargets="CoreCompile">
    <GetFileHash Files="$(OniManagedDir)/Assembly-CSharp.dll">
      <Output TaskParameter="Hash" PropertyName="_OniAssemblyHash" />
    </GetFileHash>
    <ItemGroup>
      <_OniReference Include="@(OniRelease)" Condition="'%(OniRelease.WindowsManaged)' == '$(_OniAssemblyHash)' Or '%(OniRelease.LinuxManaged)' == '$(_OniAssemblyHash)'" />
    </ItemGroup>
    <PropertyGroup>
      <DefineConstants>$(DefineConstants);@(_OniReference->'%(Features)')</DefineConstants>
    </PropertyGroup>
  </Target>
</Project>
